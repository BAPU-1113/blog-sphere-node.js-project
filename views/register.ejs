<%- include('partials/head', { title: 'Create Account - BlogSphere' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="form-card-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div class="brand-icon" style="margin: 0 auto 1rem; width: 3rem; height: 3rem; font-size: 1.4rem;">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h1 class="form-heading">Create Account</h1>
      <p class="form-subheading">Join BlogSphere with Multiuser Support and Role-Based Access.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/register" method="POST">
      <!-- Username -->
      <div class="form-group">
        <label for="username" class="form-label">Username <span style="color: var(--color-danger);">*</span></label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          class="form-control" 
          placeholder="e.g. john_doe" 
          value="<%= formData.username || '' %>" 
          required 
          minlength="3" 
          maxlength="30" 
        />
      </div>

      <!-- Email -->
      <div class="form-group">
        <label for="email" class="form-label">Email Address <span style="color: var(--color-danger);">*</span></label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="form-control" 
          placeholder="e.g. john@example.com" 
          value="<%= formData.email || '' %>" 
          required 
        />
      </div>

      <!-- Role Selection (Role-Based Access) -->
      <div class="form-group">
        <label for="role" class="form-label">Account Role (RBAC)</label>
        <select id="role" name="role" class="form-control">
          <option value="user" <%= (formData.role !== 'admin') ? 'selected' : '' %>>Standard User (Write & Manage Own Articles)</option>
          <option value="admin" <%= (formData.role === 'admin') ? 'selected' : '' %>>Admin (Full Moderation, Edit & Delete Any Article/Comment)</option>
        </select>
        <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.35rem; display: block;">
          Select 'Admin' to test role-based moderator access controls.
        </small>
      </div>

      <!-- Bio (Optional) -->
      <div class="form-group">
        <label for="bio" class="form-label">Short Bio (optional)</label>
        <input 
          type="text" 
          id="bio" 
          name="bio" 
          class="form-control" 
          placeholder="e.g. Full-stack developer and cloud architect" 
          value="<%= formData.bio || '' %>" 
        />
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password" class="form-label">Password <span style="color: var(--color-danger);">*</span></label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          placeholder="Minimum 6 characters" 
          required 
          minlength="6" 
        />
      </div>

      <!-- Confirm Password -->
      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirm Password <span style="color: var(--color-danger);">*</span></label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          class="form-control" 
          placeholder="Re-enter password" 
          required 
        />
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.8rem; margin-top: 0.5rem; font-size: 1rem;">
        Register Account
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.75rem; font-size: 0.9rem; color: var(--text-secondary);">
      Already have an account? 
      <a href="/login" style="color: var(--color-primary); font-weight: 700;">Sign in &rarr;</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
