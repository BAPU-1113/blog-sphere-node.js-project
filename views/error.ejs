<%- include('partials/head', { title: title || 'Error - BlogSphere' }) %>
<%- include('partials/navbar') %>

<main class="container" style="padding: 5rem 1.5rem; text-align: center;">
  <div style="max-width: 540px; margin: 0 auto; background: white; padding: 3rem 2rem; border-radius: var(--radius-xl); border: 1px solid var(--border-light); box-shadow: var(--shadow-md);">
    <div style="font-size: 3.5rem; font-weight: 800; color: <%= statusCode === 403 ? '#dc2626' : (statusCode === 404 ? 'var(--color-primary)' : '#f59e0b') %>; line-height: 1; margin-bottom: 1rem;">
      <%= typeof statusCode !== 'undefined' ? statusCode : 'Notice' %>
    </div>

    <h1 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.75rem;">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong.' %>
    </h1>

    <% if (typeof details !== 'undefined' && details) { %>
      <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 2rem;">
        <%= details %>
      </p>
    <% } %>

    <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 1.5rem;">
      <a href="/articles" class="btn btn-primary">
        <i class="fa-solid fa-house"></i> Back to Feed
      </a>
      <% if (!currentUser) { %>
        <a href="/login" class="btn btn-outline">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In
        </a>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
